{
  "protocol": "MULTIVERSE_PROVIDER_ADAPTER_CONTRACT_V1",
  "status": "CANDIDATE_ONLY",
  "runtime": "OFF",
  "authority": {
    "canonical": "github_canonical_state",
    "packet": "bootstrap_only",
    "provider": "executor_only",
    "owner_gates": "unchanged",
    "independent_review": "unchanged"
  },
  "capabilities": [
    "accept_bootstrap",
    "fresh_read",
    "reconstruct_state",
    "execute_owner_free_step",
    "emit_checkpoint",
    "emit_receipt",
    "report_blocker"
  ],
