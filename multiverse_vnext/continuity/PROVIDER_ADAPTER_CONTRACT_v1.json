    "repository",
    "canonical_branch",
    "canonical_sha",
    "canonical_control_pointers",
    "active_candidate_pointers",
    "mission",
    "completed_steps",
    "first_uncommitted_step",
    "side_effect_states",
    "receipts",
    "blockers",
    "owner_gates",
    "next_action",
    "generated_at"
  ],
  "side_effect_states": ["NONE", "ATTEMPTED", "VERIFIED", "UNVERIFIED"],
