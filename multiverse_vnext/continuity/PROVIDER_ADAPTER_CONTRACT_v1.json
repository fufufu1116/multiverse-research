    "AVAILABLE",
    "BOOTSTRAP",
    "FRESH_READ",
    "STATE_RECONSTRUCTED",
    "AUTHORITY_CHECK",
    "EXECUTABLE_STEP",
    "CHECKPOINT",
    "EXECUTE",
    "VERIFY",
    "RESUME",
    "FAIL_CLOSED",
    "UNAVAILABLE",
    "HANDOFF_READY"
  ],
  "provider_unavailable_transition": "EXECUTOR_ACTIVE -> PROVIDER_UNAVAILABLE -> HANDOFF_READY",
  "resume_transition": "HANDOFF_READY -> REPLACEMENT_PROVIDER -> BOOTSTRAP",
  "secret_policy": "never_store_credentials_tokens_private_keys_cookies_or_secrets",
